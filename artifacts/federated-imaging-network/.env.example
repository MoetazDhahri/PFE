# Copy to .env.local (or export directly) for local development.
# Never commit real values. Vite only exposes vars prefixed VITE_ to the client.

# Required — same Clerk development instance as the API server's
# CLERK_PUBLISHABLE_KEY (see clerk.com dashboard).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional — only needed in production behind a custom domain, where
# clerkProxyMiddleware.ts proxies Clerk's Frontend API through /api/__clerk.
# Leave unset for local dev.
# VITE_CLERK_PROXY_URL=
