# Copy to .env.local (or export directly) for local development.
# Never commit real values.

PORT=8080
NODE_ENV=development

# Required — Postgres connection string. For local dev, run Postgres in
# Docker: `docker run -d -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=federation -p 15432:5432 postgres:16-alpine`
DATABASE_URL=postgresql://postgres:devpassword@localhost:15432/federation

# Required — Clerk (see clerk.com dashboard for a development instance).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Required only to call POST /network/agent/assessments — the Federation
# Agent's model provider. Groq's free tier works for development
# (console.groq.com). Any OpenAI-compatible endpoint works via the two
# override variables below.
GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# AGENT_MODEL=openai/gpt-oss-120b
